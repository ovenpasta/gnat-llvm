with "adawebpack.gpr";

project Hello_Web is

   for Target use AdaWebPack'Target;
   for Runtime ("Ada") use AdaWebPack'Runtime ("Ada");

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use ".";
   for Main use ("main.adb");

   package Compiler renames AdaWebPack.Compiler;

   package Binder is
      for Switches ("Ada") use ("-z");
   end Binder;

   package Linker is
      for Switches ("Ada") use AdaWebPack.Linker_Switches;
   end Linker;

   package Builder is
      for Executable ("main.adb") use "main.wasm";
   end Builder;

end Hello_Web;
