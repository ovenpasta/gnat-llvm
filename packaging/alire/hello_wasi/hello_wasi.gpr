project Hello_Wasi is

   --  Set by the gnat_llvm toolchain crate's environment
   Prefix := external ("GNAT_LLVM_PREFIX");

   for Target use "llvm";
   for Runtime ("Ada") use Prefix & "/lib/gnat-llvm/wasm32/rts-wasm-wasi-eh";

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("hello_wasi.adb", "unhandled.adb");

   package Compiler is
      for Switches ("Ada") use ("--target=wasm32-wasip1", "-O1");
   end Compiler;

   package Linker is
      for Switches ("Ada") use
        ("--target=wasm32-wasip1",
         "--sysroot=" & Prefix & "/share/wasi-sysroot");
   end Linker;

   package Builder is
      for Executable ("hello_wasi.adb") use "hello_wasi.wasm";
      for Executable ("unhandled.adb") use "unhandled.wasm";
   end Builder;

end Hello_Wasi;
